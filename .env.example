APP_NAME="Bongo"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
APP_PORT=8000
APP_TIMEZONE=UTC
APP_LOCALE=en

# -----------------------------------------------------------------------------
# Primary Database Connection
# Supported drivers: mysql | pgsql | sqlite
# -----------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=bongo_framework
DB_USERNAME=root
DB_PASSWORD=
DB_SOCKET=

# PostgreSQL specific settings (DB_CONNECTION=pgsql)
# DB_SCHEMA=public
# DB_SSLMODE=prefer

# SQLite specific settings (DB_CONNECTION=sqlite)
# DB_SQLITE_PATH=database/database.sqlite

# -----------------------------------------------------------------------------
# Simultaneous Multi-Database & Multi-Tenancy (Optional Secondary Connection)
# Query with DB::connection('secondary') or Model::on('secondary')
# -----------------------------------------------------------------------------
# DB_SECONDARY_PATH=database/secondary.sqlite

# -----------------------------------------------------------------------------
# Drivers: Queue, Cache & Session
# Queue: sync | database | redis
# Cache: file | redis
# Session: cookie | file | redis
# -----------------------------------------------------------------------------
QUEUE_DRIVER=sync
CACHE_DRIVER=file
SESSION_DRIVER=cookie
SESSION_TOKEN_GRACE_WINDOW=10

# -----------------------------------------------------------------------------
# Redis Configuration (when QUEUE_DRIVER=redis or CACHE_DRIVER=redis)
# -----------------------------------------------------------------------------
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_PREFIX=bongo:

# -----------------------------------------------------------------------------
# File Storage (Multi-Disk: public | local | s3)
# -----------------------------------------------------------------------------
STORAGE_DISK=public

# S3 / DigitalOcean Spaces / Cloudflare R2 / MinIO (when STORAGE_DISK=s3 or using s3 package)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=us-east-1
# AWS_BUCKET=
# AWS_URL=
# AWS_ENDPOINT=
# AWS_USE_PATH_STYLE_ENDPOINT=false

# -----------------------------------------------------------------------------
# Logging Subsystem
# Channel: daily | single
# Level: debug | info | notice | warning | error | critical | alert | emergency
# Format: text (human-readable) | json (structured for cloud/ELK/Datadog)
# -----------------------------------------------------------------------------
LOG_CHANNEL=daily
LOG_LEVEL=debug
LOG_FORMAT=text

# -----------------------------------------------------------------------------
# Mail Configuration
# Driver: log (writes to storage/logs) | smtp (real delivery) | file (JSON files)
# -----------------------------------------------------------------------------
MAIL_DRIVER=log
MAIL_HOST=localhost
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=no-reply@example.com
MAIL_FROM_NAME="${APP_NAME}"

# -----------------------------------------------------------------------------
# WebSockets & Broadcasting (php bongo websocket:serve)
# -----------------------------------------------------------------------------
BROADCAST_HOST=127.0.0.1
BROADCAST_PORT=6001
BROADCAST_PUBLIC_URL=
BROADCAST_ALLOWED_ORIGINS=

# -----------------------------------------------------------------------------
# API & JWT Authentication
# -----------------------------------------------------------------------------
JWT_SECRET=
JWT_TTL=60
JWT_REFRESH_TTL=20160

# -----------------------------------------------------------------------------
# Notification Channels (SMS & Slack)
# -----------------------------------------------------------------------------
SMS_URL=
SMS_TOKEN=
SLACK_WEBHOOK_URL=

# -----------------------------------------------------------------------------
# Official Bongo Packages Subsystem (php bongo add / package:install)
# -----------------------------------------------------------------------------
# GitHub token for private package repository access (or falls back to GITHUB_TOKEN):
BONGO_PACKAGES_TOKEN=
# Optional local development path override (default: ../bongo-php-packages if present):
# BONGO_PACKAGES_PATH=../bongo-php-packages

# SSLCommerz Payment Gateway (package: sslcommerz)
# SSLCOMMERZ_STORE_ID=
# SSLCOMMERZ_STORE_PASSWORD=
# SSLCOMMERZ_SANDBOX=true

# bKash Tokenized Checkout (package: bkash)
# BKASH_APP_KEY=
# BKASH_APP_SECRET=
# BKASH_USERNAME=
# BKASH_PASSWORD=
# BKASH_SANDBOX=true

# Nagad Direct MFS Gateway (package: nagad - RSA-2048 encryption & signatures)
# NAGAD_MERCHANT_ID=
# NAGAD_MERCHANT_PRIVATE_KEY=storage/keys/nagad_private.pem
# NAGAD_PUBLIC_KEY=storage/keys/nagad_public.pem
# NAGAD_SANDBOX=true
# NAGAD_CALLBACK_URL=http://127.0.0.1:8000/nagad/callback

# Social Login (package: social-login - OAuth 2.0 Google, GitHub, Facebook)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# FACEBOOK_CLIENT_ID=
# FACEBOOK_CLIENT_SECRET=

# Stripe International Payments (package: stripe - Checkout, PaymentIntents, Webhooks)
# STRIPE_KEY=pk_test_...
# STRIPE_SECRET=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_CURRENCY=usd

# Two-Factor Authentication (package: two-factor - RFC 6238 TOTP, pure-PHP QR codes)
# TWO_FACTOR_ISSUER="${APP_NAME}"

# Image Processing & Optimization (package: image - ext-gd, smart cropping, WebP)
# IMAGE_QUALITY=85
# IMAGE_WATERMARK_POSITION=bottom-right
# IMAGE_WATERMARK_OPACITY=80

# Database & Asset Backup Manager (package: backup - zero-dependency dumpers, ZipArchiver)
# BACKUP_DISK=local
# BACKUP_KEEP_COUNT=10
# BACKUP_KEEP_DAYS=30

# Role-Based Access Control (package: permission)
# PERMISSION_SUPER_ADMIN_ROLE=super-admin

# Pure-PHP ZIP Compression & Archive Inspection (package: zip)
# ZIP_MEMORY_LIMIT=256M

# FTP & FTPS Storage Disk (package: ftp)
# FTP_HOST=127.0.0.1
# FTP_PORT=21
# FTP_USERNAME=
# FTP_PASSWORD=
# FTP_ROOT=/
# FTP_SSL=false
# FTP_PASSIVE=true
# FTP_TIMEOUT=30

# PayPal REST API v2 Checkout (package: paypal)
# PAYPAL_MODE=sandbox
# PAYPAL_CLIENT_ID=
# PAYPAL_CLIENT_SECRET=
# PAYPAL_WEBHOOK_ID=
# PAYPAL_CURRENCY=USD
# PAYPAL_RETURN_URL=/paypal/success
# PAYPAL_CANCEL_URL=/paypal/cancel

# API Development Tools (package: api-tools - OpenAPI 3.0 docs, rate limiting, resources)
# API_TITLE="Bongo API"
# API_VERSION=1.0.0
# API_DOCS_ENABLED=true
# API_THROTTLE_MAX=60
# API_THROTTLE_DECAY=1

# Dynamic Settings (package: settings - database application settings with type casting)
# SETTINGS_TABLE=settings
# SETTINGS_CACHE_ENABLED=true
# SETTINGS_CACHE_TTL=3600

# Search Engine Optimization (package: seo - OpenGraph, Twitter Cards, Schema.org JSON-LD, Sitemap)
# SEO_TITLE_SEPARATOR=" - "
# SEO_ROBOTS="index, follow"

# Enterprise Audit Trail (package: activity-log - model activity & diff tracker)
# ACTIVITY_LOG_TABLE=activity_log
# ACTIVITY_LOG_RETENTION_DAYS=60

# Production Health Checks (package: health - uptime monitoring & vitals)
# HEALTH_SECRET_TOKEN=
# HEALTH_DISK_MIN_FREE_MB=500

# Web File Manager & Code Editor (package: file-manager - zero-dependency file manager with code editor)
# FILEMANAGER_PREFIX=filemanager
# FILEMANAGER_DISK=public
# FILEMANAGER_BASE_DIR=
# FILEMANAGER_READ_ONLY=false
# FILEMANAGER_MAX_FILE_SIZE_KB=20480


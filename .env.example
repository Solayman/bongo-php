APP_NAME="Bongo Framework"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
APP_PORT=8000
APP_TIMEZONE=UTC
APP_LOCALE=en

# -----------------------------------------------------------------------------
# Primary Database Connection
# Supported drivers: mysql | pgsql | sqlite
# -----------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=bongo_framework
DB_USERNAME=root
DB_PASSWORD=
DB_SOCKET=

# PostgreSQL specific settings (DB_CONNECTION=pgsql)
# DB_SCHEMA=public
# DB_SSLMODE=prefer

# SQLite specific settings (DB_CONNECTION=sqlite)
# DB_SQLITE_PATH=database/database.sqlite

# -----------------------------------------------------------------------------
# Simultaneous Multi-Database & Multi-Tenancy (Optional Secondary Connection)
# Query with DB::connection('secondary') or Model::on('secondary')
# -----------------------------------------------------------------------------
# DB_SECONDARY_PATH=database/secondary.sqlite

# -----------------------------------------------------------------------------
# Drivers: Queue, Cache & Session
# Queue: sync | database | redis
# Cache: file | redis
# Session: cookie | file | redis
# -----------------------------------------------------------------------------
QUEUE_DRIVER=sync
CACHE_DRIVER=file
SESSION_DRIVER=cookie

# -----------------------------------------------------------------------------
# Redis Configuration (when QUEUE_DRIVER=redis or CACHE_DRIVER=redis)
# -----------------------------------------------------------------------------
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_PREFIX=bongo:

# -----------------------------------------------------------------------------
# File Storage (Multi-Disk: public | local | s3)
# -----------------------------------------------------------------------------
STORAGE_DISK=public

# S3 / DigitalOcean Spaces / Cloudflare R2 / MinIO (when STORAGE_DISK=s3 or using s3 package)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=us-east-1
# AWS_BUCKET=
# AWS_URL=
# AWS_ENDPOINT=
# AWS_USE_PATH_STYLE_ENDPOINT=false

# -----------------------------------------------------------------------------
# Logging Subsystem
# Channel: daily | single
# Level: debug | info | notice | warning | error | critical | alert | emergency
# Format: text (human-readable) | json (structured for cloud/ELK/Datadog)
# -----------------------------------------------------------------------------
LOG_CHANNEL=daily
LOG_LEVEL=debug
LOG_FORMAT=text

# -----------------------------------------------------------------------------
# Mail Configuration
# Driver: log (writes to storage/logs) | smtp (real delivery) | file (JSON files)
# -----------------------------------------------------------------------------
MAIL_DRIVER=log
MAIL_HOST=localhost
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=no-reply@example.com
MAIL_FROM_NAME="${APP_NAME}"

# -----------------------------------------------------------------------------
# WebSockets & Broadcasting (php bongo websocket:serve)
# -----------------------------------------------------------------------------
BROADCAST_HOST=127.0.0.1
BROADCAST_PORT=6001
BROADCAST_PUBLIC_URL=
BROADCAST_ALLOWED_ORIGINS=

# -----------------------------------------------------------------------------
# API & JWT Authentication
# -----------------------------------------------------------------------------
JWT_SECRET=
JWT_TTL=60
JWT_REFRESH_TTL=20160

# -----------------------------------------------------------------------------
# Notification Channels (SMS & Slack)
# -----------------------------------------------------------------------------
SMS_URL=
SMS_TOKEN=
SLACK_WEBHOOK_URL=

# -----------------------------------------------------------------------------
# Official Bongo Packages Subsystem (php bongo add / package:install)
# -----------------------------------------------------------------------------
# GitHub token for private package repository access (or falls back to GITHUB_TOKEN):
BONGO_PACKAGES_TOKEN=
# Optional local development path override (default: ../bongo-php-packages if present):
# BONGO_PACKAGES_PATH=../bongo-php-packages


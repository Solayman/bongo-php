APP_NAME="Bongo Framework"
APP_ENV=local
APP_URL=http://127.0.0.1:8000
APP_PORT=8000

# Database: mysql | sqlite | pgsql
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=bongo_framework
DB_USERNAME=root
DB_PASSWORD=
# DB_SCHEMA=public
# DB_SSLMODE=prefer
# DB_SQLITE_PATH=

# Queue & Cache Drivers
QUEUE_DRIVER=sync
CACHE_DRIVER=file
SESSION_DRIVER=cookie

# Redis Configuration (when QUEUE_DRIVER=redis or CACHE_DRIVER=redis)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_PREFIX=bongo:

# Logging: text | json
LOG_CHANNEL=daily
LOG_LEVEL=debug
LOG_FORMAT=text


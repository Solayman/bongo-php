#!/usr/bin/env php
<?php
// Bongo command line tool: php bongo <command>

// Tests and config:* always read config/*.php, never a cached copy (a cached
// DB_DATABASE would point the tests at the real database)
if (in_array($_SERVER['argv'][1] ?? '', ['test', 'config:cache', 'config:clear', 'route:cache', 'route:clear'], true)) {
    putenv('BONGO_CONFIG_CACHE=0');
    putenv('BONGO_ROUTE_CACHE=0');
}
require __DIR__ . '/config/bootstrap.php';

use System\Database\Migrator;

$args = array_slice($_SERVER['argv'], 1);
$command = $args[0] ?? 'help';
$options = array_slice($args, 1);
$hasOption = fn(string $name) => in_array("--$name", $options, true);
$optionValue = function (string $name, $default = null) use ($options) {
    foreach ($options as $opt) {
        if (str_starts_with($opt, "--$name=")) {
            return substr($opt, strlen($name) + 3);
        }
    }
    return $default;
};

$databaseOption = $optionValue('database');
$migrator = fn(?string $conn = null) => new Migrator(base_path('database/migrations'), $conn ?? $databaseOption);

try {
    switch ($command) {
        case '--version':
        case '-V':
            echo 'Bongo ' . System\Framework::version() . PHP_EOL;
            break;

        case 'release:package':
        case 'release:branch':
        case 'release:build':
            // Maintainer tools: only in the framework repository, not in projects
            if (!is_file(BASE_PATH . '/release/tools/commands.php')) {
                throw new RuntimeException("$command is a maintainer tool of the Bongo repository; projects don't include it.");
            }
            require_once BASE_PATH . '/release/tools/commands.php';
            runReleaseCommand($command, $options, $optionValue);
            break;

        case 'upgrade':
            $upgrader = new System\Console\Upgrader(BASE_PATH);
            if ($hasOption('rollback')) {
                echo 'Restored Bongo ' . $upgrader->rollback() . ' from the backup.' . PHP_EOL;
                break;
            }
            $sha = null;
            if ($from = $optionValue('from')) {
                $package = $from;
                $shaFile = "$from.sha256";
                $sha = is_file($shaFile) ? strtok((string) file_get_contents($shaFile), ' ') : null;
            } else {
                [$latest, $notes, $packageUrl, $shaUrl] = $upgrader->latest();
                $current = System\Framework::version();
                echo "Installed: $current    Latest: $latest" . PHP_EOL;
                if (version_compare($latest, $current, '<=')) {
                    echo 'You have the latest version.' . PHP_EOL;
                    break;
                }
                if ($notes !== '') {
                    echo PHP_EOL . "What changed in $latest:" . PHP_EOL . $notes . PHP_EOL . PHP_EOL;
                }
                if ((int) explode('.', $latest)[0] > (int) explode('.', $current)[0]) {
                    echo "\033[33m$latest is a major version: read UPGRADE.md before upgrading.\033[0m" . PHP_EOL;
                }
                if ($hasOption('check')) {
                    echo 'Run php bongo upgrade to install it.' . PHP_EOL;
                    break;
                }
                if (!$packageUrl || !$shaUrl) {
                    throw new RuntimeException("The $latest release has no framework package (.json.gz and .sha256) attached.");
                }
                $package = BASE_PATH . '/storage/upgrade-' . $latest . '.json.gz';
                file_put_contents($package, $upgrader->download($packageUrl));
                $sha = strtok($upgrader->download($shaUrl), ' ');
            }
            $result = $upgrader->apply($package, $sha);
            echo "Upgraded Bongo {$result['from']} → {$result['to']} ({$result['files']} framework files)." . PHP_EOL;
            echo 'Backup: ' . relative_path($result['backup']) . '   (undo with: php bongo upgrade --rollback)' . PHP_EOL;
            foreach ($result['newConfig'] as $file => $keys) {
                echo "New settings in config/$file: " . implode(', ', $keys) . ' (copy them from the release, or keep the defaults)' . PHP_EOL;
            }
            echo 'Next: php bongo migrate, then php bongo test' . PHP_EOL;
            break;

        case 'down':
            $secret = $optionValue('secret');
            System\Http\Maintenance::down((string) $optionValue('message', ''), (int) $optionValue('retry', 60), $secret);
            echo "The site is in maintenance mode: visitors see \"We'll be back soon\" (HTTP 503)." . PHP_EOL;
            if ($secret) {
                echo 'Visit ' . url('/' . trim($secret, '/')) . ' once to keep using the site in your browser.' . PHP_EOL;
            }
            echo 'Turn it off with: php bongo up' . PHP_EOL;
            break;

        case 'up':
            echo System\Http\Maintenance::up() ? 'The site is live again.' . PHP_EOL : 'The site was not in maintenance mode.' . PHP_EOL;
            break;

        case 'about':
            $size = System\Framework::size();
            $rows = [
                'Bongo'      => System\Framework::version(),
                'PHP'           => PHP_VERSION,
                'Environment'   => (string) config('app.env') . (config('app.debug') ? ' (debug on)' : ''),
                'URL'           => (string) config('app.url'),
                'Database'      => config('database.default') . ' · ' . config('database.connections.' . config('database.default') . '.database'),
                'Mail driver'   => (string) config('mail.driver'),
                'Queue driver'  => (string) config('queue.driver'),
                'Framework'     => "{$size['files']} files · " . number_format($size['lines']) . " lines · {$size['kb']} KB (system/)",
                'Dependencies'  => file_exists(base_path('vendor/autoload.php')) ? 'Composer packages loaded (optional)' : 'none',
            ];
            foreach ($rows as $label => $value) {
                echo str_pad($label, 15) . $value . PHP_EOL;
            }
            break;

        case 'serve':
            $host = $optionValue('host', '127.0.0.1');
            $port = (int) $optionValue('port', env('APP_PORT', 8000));
            // Warn about the usual first-run problems before starting
            try {
                System\Security\Key::get();
            } catch (Throwable $e) {
                echo "\033[33mWarning:\033[0m APP_KEY is missing. Sign-in will fail. Run: php bongo key:generate" . PHP_EOL;
            }
            if ($pending = System\Database\MigrationHint::pending()) {
                echo "\033[33mWarning:\033[0m " . count($pending) . ' migration(s) have not run. Run: php bongo migrate' . PHP_EOL;
            }
            echo "Starting development server: http://$host:$port\n";
            echo "Press Ctrl+C to stop.\n";
            passthru(escapeshellarg(PHP_BINARY) . " -S $host:$port -t " . escapeshellarg(__DIR__ . '/public'));
            break;

        case 'migrate':
            $done = $migrator()->migrate(fn($name) => print("Migrated: $name\n"));
            echo $done ? "Done.\n" : "Nothing to migrate.\n";
            break;

        case 'migrate:status':
            $rows = $migrator()->status();
            if (!$rows) {
                echo "No migrations found.\n";
                break;
            }
            $width = max(array_map(fn($r) => strlen($r['migration']), $rows)) + 2;
            printf("%-{$width}s %-8s %-6s %s\n", 'Migration', 'Status', 'Batch', 'Ran at');
            foreach ($rows as $r) {
                $status = $r['ran'] ? ($r['missing'] ? 'Ran*' : 'Ran') : 'Pending';
                printf("%-{$width}s %-8s %-6s %s\n", $r['migration'], $status, $r['batch'] ?? '', $r['ran_at'] ?? '');
            }
            if (array_filter($rows, fn($r) => $r['missing'])) {
                echo "\n* recorded in the migrations table but the file is missing\n";
            }
            break;

        case 'migrate:rollback':
            $steps = (int) $optionValue('step', 1);
            $done = $migrator()->rollback($steps, fn($name) => print("Rolled back: $name\n"));
            echo $done ? "Done.\n" : "Nothing to roll back.\n";
            break;

        case 'make:migration':
            if (empty($options[0])) {
                echo "Usage: php bongo make:migration create_posts_table\n";
                exit(1);
            }
            $file = $migrator()->make($options[0]);
            echo 'Created: ' . relative_path($file) . PHP_EOL;
            break;

        case 'migrate:fresh':
            $targetConn = $databaseOption ?? config('database.default');
            $database = config("database.connections.{$targetConn}.database");
            if (!$hasOption('force')) {
                echo "This drops ALL tables in database [$database] (connection: $targetConn). Type the database name to continue: ";
                if (trim((string) fgets(STDIN)) !== (string) $database) {
                    echo "Cancelled.\n";
                    exit(1);
                }
            }
            $freshMigrator = $migrator($targetConn);
            foreach ($freshMigrator->dropAllTables() as $table) {
                echo "Dropped: $table\n";
            }
            $freshMigrator->migrate(fn($name) => print("Migrated: $name\n"));
            if ($hasOption('seed')) {
                runSeeder($targetConn);
            }
            break;

        case 'db:seed':
            runSeeder($databaseOption);
            break;

        case 'key:generate':
            $key = System\Security\Key::generate();
            if ($hasOption('show')) {
                echo $key . "\n";
                break;
            }

            $envFile = base_path('.env');
            if (!file_exists($envFile)) {
                copy(base_path('.env.example'), $envFile);
            }
            $contents = file_get_contents($envFile);

            if (preg_match('/^APP_KEY=(.+)$/m', $contents, $m) && trim($m[1]) !== '' && !$hasOption('force')) {
                echo "APP_KEY is already set. Changing it invalidates every stored password and encrypted value.\n";
                echo "Use --force only if you really want a new key.\n";
                exit(1);
            }

            $contents = preg_match('/^APP_KEY=.*$/m', $contents)
                ? preg_replace('/^APP_KEY=.*$/m', 'APP_KEY=' . $key, $contents)
                : rtrim($contents) . "\nAPP_KEY=" . $key . "\n";
            file_put_contents($envFile, $contents);
            echo "Application key set in .env\n";
            break;

        case 'route:list':
            $router = System\Routing\Router::fromConfig();
            $rows = [];
            foreach ($router->routes() as $route) {
                $action = $route->action instanceof Closure ? 'Closure'
                    : (new ReflectionClass(class_exists($route->action[0]) ? $route->action[0] : 'App\\Http\\Controllers\\' . $route->action[0]))->getShortName() . '@' . $route->action[1];
                $middleware = array_map(fn($m) => (new ReflectionClass($m[0]))->getShortName() . ($m[1] ? ':' . implode(',', $m[1]) : ''), $router->resolveMiddleware($route));
                $rows[] = [implode('|', array_diff($route->methods, ['HEAD'])), $route->path, $route->name ?? '', $action, implode(', ', $middleware)];
            }
            $filter = $options[0] ?? null;
            if ($filter) {
                $rows = array_filter($rows, fn($r) => stripos(implode(' ', $r), $filter) !== false);
            }
            $widths = [6, 4, 4, 6, 10];
            foreach ($rows as $r) {
                foreach ($r as $i => $v) {
                    $widths[$i] = max($widths[$i], strlen($v));
                }
            }
            $line = fn($r) => vsprintf("%-{$widths[0]}s  %-{$widths[1]}s  %-{$widths[2]}s  %-{$widths[3]}s  %s
", $r);
            echo $line(['Method', 'Path', 'Name', 'Action', 'Middleware']);
            foreach ($rows as $r) {
                echo $line($r);
            }
            echo "
" . count($rows) . " route(s)
";
            break;

        case 'tinker':
            echo "Bongo tinker. The app is loaded: try DB::table('users')->count(), config('app'), Hash::make('x').\n";
            echo "Type exit to quit.\n";
            foreach (
                ['DB' => System\Database\DB::class, 'Schema' => System\Database\Schema\Schema::class, 'Log' => System\Log\Log::class,
                      'Hash' => System\Security\Hash::class, 'Crypt' => System\Security\Crypt::class, 'Auth' => System\Auth\Auth::class] as $alias => $class
            ) {
                if (!class_exists($alias, false)) {
                    class_alias($class, $alias);
                }
            }
            $dumper = new System\Debug\Dumper();
            while (true) {
                $line = function_exists('readline') ? readline('>>> ') : (fwrite(STDOUT, '>>> ') ? fgets(STDIN) : false);
                if ($line === false || in_array(trim($line), ['exit', 'quit'], true)) {
                    break;
                }
                $code = trim($line);
                if ($code === '') {
                    continue;
                }
                if (function_exists('readline_add_history')) {
                    readline_add_history($code);
                }
                $code = rtrim($code, ';');
                try {
                    $result = eval(str_starts_with($code, 'return ') || preg_match('/^(echo|print|if|foreach|for|while|function|class)\b/', $code) ? "$code;" : "return $code;");
                    echo '=> ' . $dumper->text($result);
                } catch (Throwable $e) {
                    echo get_class($e) . ': ' . $e->getMessage() . "\n";
                }
            }
            break;

        case 'make:controller':
        case 'make:model':
        case 'make:middleware':
        case 'make:request':
        case 'make:test':
        case 'make:policy':
        case 'make:job':
        case 'make:component':
        case 'make:seeder':
        case 'make:notification':
        case 'make:mail':
        case 'make:command':
            $name = $options[0] ?? '';
            if ($name === '' || str_starts_with($name, '--')) {
                $flags = ['make:controller' => ' [--api]', 'make:model' => ' [--migration]', 'make:test' => ' [--unit]'];
                echo "Usage: php bongo $command <Name>" . ($flags[$command] ?? '') . PHP_EOL;
                exit(1);
            }
            $generator = new System\Console\Generator(BASE_PATH);
            $created = match ($command) {
                'make:controller' => $generator->controller($name, $hasOption('api')),
                'make:model'      => $generator->model($name),
                'make:middleware' => $generator->middleware($name),
                'make:request'    => $generator->request($name),
                'make:test'       => $generator->test($name, $hasOption('unit')),
                'make:policy'     => $generator->policy($name),
                'make:job'        => $generator->job($name),
                'make:component'  => $generator->component($name),
                'make:seeder'     => $generator->seeder($name),
                'make:notification' => $generator->notification($name),
                'make:mail'       => $generator->mail($name),
                'make:command'    => $generator->command($name),
            };
            echo "Created: $created" . PHP_EOL;
            if ($command === 'make:model' && $hasOption('migration')) {
                $table = $generator->tableName(basename(strtr($name, '\\', '/')));
                $file = $migrator()->make("create_{$table}_table");
                echo 'Created: ' . relative_path($file) . PHP_EOL;
            }
            break;

        case 'security:check':
            $results = System\Security\SecurityCheck::run();
            $marks = ['ok' => "\033[32m  OK  \033[0m", 'warn' => "\033[33m WARN \033[0m", 'fail' => "\033[31m FAIL \033[0m"];
            $width = max(array_map(fn($r) => strlen($r['check']), $results)) + 2;
            echo 'Security check (APP_ENV=' . config('app.env') . ')' . PHP_EOL . PHP_EOL;
            foreach ($results as $r) {
                printf("%s %-{$width}s %s%s", $marks[$r['status']], $r['check'], $r['detail'], PHP_EOL);
            }
            $summary = System\Security\SecurityCheck::summary($results);
            echo PHP_EOL . ($summary === 'ok' ? 'All checks passed.' : ($summary === 'warn' ? 'Some warnings: review them before going live.' : 'Some checks FAILED: fix them before going live.')) . PHP_EOL;
            exit($summary === 'fail' ? 1 : 0);

        case 'queue:work':
            if (System\Queue\Queue::driver() === 'sync') {
                echo 'QUEUE_DRIVER is "sync": jobs already run immediately. Set QUEUE_DRIVER=database to use a worker.' . PHP_EOL;
            }
            $worker = new System\Queue\Worker(fn($line) => print(date('[H:i:s] ') . $line . PHP_EOL));
            $count = $worker->work([
                'queue' => $optionValue('queue', 'default'),
                'sleep' => (int) $optionValue('sleep', 3),
                'max_jobs' => (int) $optionValue('max-jobs', 0),
                'max_time' => (int) $optionValue('max-time', 0),
                'stop_when_empty' => $hasOption('stop-when-empty'),
                'once' => $hasOption('once'),
            ]);
            echo "Processed $count job(s)." . PHP_EOL;
            break;

        case 'queue:failed':
            $failed = System\Database\DB::table('failed_jobs')->orderBy('id', 'DESC')->limit(50)->get();
            if (!$failed) {
                echo 'No failed jobs.' . PHP_EOL;
                break;
            }
            foreach ($failed as $f) {
                $job = @unserialize(base64_decode((string) $f->payload));
                printf("#%d  %s  %s  %s%s", $f->id, $f->failed_at, $job instanceof System\Queue\Job ? $job->displayName() : '?', strtok((string) $f->exception, "\n"), PHP_EOL);
            }
            echo PHP_EOL . 'Retry with: php bongo queue:retry <id|all>' . PHP_EOL;
            break;

        case 'queue:retry':
            $n = System\Queue\Worker::retry($options[0] ?? 'all');
            echo "Moved $n job(s) back onto the queue." . PHP_EOL;
            break;

        case 'queue:flush':
            System\Database\DB::table('failed_jobs')->delete(true);
            echo 'Deleted all failed jobs.' . PHP_EOL;
            break;

        case 'schedule:run':
            $now = new DateTimeImmutable();
            $due = System\Scheduling\Schedule::load()->due($now);
            if (!$due) {
                echo 'No scheduled tasks are due at ' . $now->format('H:i') . '.' . PHP_EOL;
                break;
            }
            $failed = 0;
            foreach ($due as $task) {
                try {
                    echo date('[H:i:s] ') . $task->getName() . ': ' . $task->run() . PHP_EOL;
                } catch (Throwable $e) {
                    $failed++;
                    System\Log\Log::error('Scheduled task "{task}" failed: ' . $e->getMessage(), ['task' => $task->getName(), 'exception' => $e]);
                    echo date('[H:i:s] ') . $task->getName() . ': FAILED ' . $e->getMessage() . PHP_EOL;
                }
            }
            exit($failed ? 1 : 0);

        case 'schedule:work':
            // For development: no cron needed. Each minute runs "schedule:run" in a fresh process,
            // so code changes are picked up and a crashing task can't stop the loop.
            echo 'Running the scheduler every minute. Press Ctrl+C to stop.' . PHP_EOL;
            $minutes = (int) $optionValue('minutes', 0);   // --minutes=N: stop after N runs (0 = forever)
            for ($run = 1; $minutes === 0 || $run <= $minutes; $run++) {
                $wait = 60 - (int) date('s');
                if ($run > 1 || $hasOption('wait')) {
                    sleep($wait);
                }
                passthru(escapeshellarg(PHP_BINARY) . ' ' . escapeshellarg(__FILE__) . ' schedule:run');
            }
            break;

        case 'websocket:serve':
            // Live updates for open pages: Broadcast::to('orders')->send(...) arrives in the browser
            $server = new System\Broadcasting\Server(
                (string) $optionValue('host', config('broadcasting.host', '127.0.0.1')),
                (int) $optionValue('port', config('broadcasting.port', 6001)),
                (array) config('broadcasting.allowed_origins', [])
            );
            $server->listen();
            echo 'Browsers connect to ' . System\Broadcasting\Broadcast::publicUrl() . '. Press Ctrl+C to stop.' . PHP_EOL;
            $server->run();
            break;

        case 'schedule:list':
            $tasks = System\Scheduling\Schedule::load()->tasks();
            $now = new DateTimeImmutable();
            $width = max(array_map(fn($t) => strlen($t->getName()), $tasks)) + 2;
            printf("%-15s %-{$width}s %s%s", 'Cron', 'Task', 'Next run', PHP_EOL);
            foreach ($tasks as $task) {
                printf("%-15s %-{$width}s %s%s", $task->expression(), $task->getName(), $task->nextRun($now)?->format('Y-m-d H:i') ?? '-', PHP_EOL);
            }
            break;

        case 'cache:clear':
            echo 'Removed ' . System\Cache\Cache::flush() . ' cache file(s)' . PHP_EOL;
            break;

        case 'config:cache':
            // One file instead of every config/*.php on each request. Values must be plain data.
            $check = function ($value, string $path) use (&$check) {
                if (is_array($value)) {
                    foreach ($value as $key => $item) {
                        $check($item, "$path.$key");
                    }
                } elseif (!is_scalar($value) && $value !== null) {
                    throw new RuntimeException("config('$path') is not plain data (" . get_debug_type($value) . '), so the config cannot be cached.');
                }
            };
            $config = load_config_files();
            $check($config, 'config');
            if (!is_dir(dirname(CONFIG_CACHE))) {
                mkdir(dirname(CONFIG_CACHE), 0775, true);
            }
            $tmp = CONFIG_CACHE . '.' . bin2hex(random_bytes(4));
            file_put_contents($tmp, "<?php\n// Made by php bongo config:cache. Run it again after changing config/ or .env (or: php bongo config:clear)\nreturn " . var_export($config, true) . ";\n");
            rename($tmp, CONFIG_CACHE);
            if (function_exists('opcache_invalidate')) {
                @opcache_invalidate(CONFIG_CACHE, true);
            }
            echo 'Config cached in ' . relative_path(CONFIG_CACHE) . '. Run php bongo config:cache again after changing config/ or .env.' . PHP_EOL;
            break;

        case 'config:clear':
            echo is_file(CONFIG_CACHE) && unlink(CONFIG_CACHE) ? 'Config cache removed: config/*.php is read on every request again.' : 'No config cache.';
            echo PHP_EOL;
            break;

        case 'route:cache':
            $router = System\Routing\Router::fromConfig();
            $data = $router->toCache();
            if (!is_dir(dirname(ROUTE_CACHE))) {
                mkdir(dirname(ROUTE_CACHE), 0775, true);
            }
            $tmp = ROUTE_CACHE . '.' . bin2hex(random_bytes(4));
            file_put_contents($tmp, "<?php\n// Made by php bongo route:cache. Run it again after changing routes/ (or: php bongo route:clear)\nreturn " . var_export($data, true) . ";\n");
            rename($tmp, ROUTE_CACHE);
            if (function_exists('opcache_invalidate')) {
                @opcache_invalidate(ROUTE_CACHE, true);
            }
            echo 'Routes cached in ' . relative_path(ROUTE_CACHE) . ' (' . count($data['routes']) . ' routes). Run php bongo route:cache again after changing routes.' . PHP_EOL;
            break;

        case 'route:clear':
            echo is_file(ROUTE_CACHE) && unlink(ROUTE_CACHE) ? 'Route cache removed: routes/ is read on every request again.' : 'No route cache.';
            echo PHP_EOL;
            break;

        case 'view:cache':
            $engine = System\View\ViewEngine::shared();
            $engine->clearCache();
            $result = $engine->compileAll(lint: true);
            foreach ($result['errors'] as $view => $message) {
                echo "  FAIL  $view: $message" . PHP_EOL;
            }
            echo "Compiled {$result['compiled']} view(s)" . ($result['errors'] ? ', ' . count($result['errors']) . ' failed' : '') . PHP_EOL;
            exit($result['errors'] ? 1 : 0);

        case 'view:clear':
            $removed = System\View\ViewEngine::shared()->clearCache();
            echo "Removed $removed compiled view(s)
";
            break;

        case 'log:clear':
            $dir = config('logging.path');
            $removed = 0;
            foreach (glob($dir . '/*.log') ?: [] as $file) {
                $removed += (int) @unlink($file);
            }
            echo "Removed $removed log file(s) from " . str_replace(BASE_PATH . DIRECTORY_SEPARATOR, '', $dir) . "
";
            break;

        case 'add':
            $target = $options[0] ?? null;
            if (!$target || str_starts_with($target, '--')) {
                throw new RuntimeException('Usage: php bongo add <package>[@version]');
            }
            $parts = explode('@', $target, 2);
            $name = $parts[0];
            $version = $parts[1] ?? null;
            $installer = new System\Package\Installer();
            $result = $installer->add($name, $version, $hasOption('force'), $hasOption('backup'));
            echo "Installed {$result['name']} ({$result['version']})." . PHP_EOL;
            if (!empty($result['backup'])) {
                echo "Backed up previous files to: " . relative_path($result['backup']) . PHP_EOL;
            }
            if ($result['config_created']) {
                echo "Published configuration: config/{$result['name']}.php" . PHP_EOL;
            }
            if (!empty($result['migrations'])) {
                echo "Package includes migration(s): " . implode(', ', $result['migrations']) . PHP_EOL;
                echo "Run: php bongo migrate" . PHP_EOL;
            }
            if (!empty($result['env_keys'])) {
                echo "Environment variables in .env:" . PHP_EOL;
                foreach ($result['env_keys'] as $key) {
                    echo "  $key" . PHP_EOL;
                }
            }
            if ($result['readme']) {
                echo "Documentation: {$result['readme']}" . PHP_EOL;
            }
            break;

        case 'package:install':
            $target = $options[0] ?? null;
            $force = $hasOption('force');
            $backup = $hasOption('backup');
            $installer = new System\Package\Installer();
            if ($target && !str_starts_with($target, '--')) {
                $parts = explode('@', $target, 2);
                $name = $parts[0];
                $version = $parts[1] ?? null;
                $result = $installer->install($name, $version, $force, $backup);
                echo "Installed {$result['name']} ({$result['version']})." . PHP_EOL;
                if (!empty($result['backup'])) {
                    echo "Backed up previous files to: " . relative_path($result['backup']) . PHP_EOL;
                }
                if ($result['config_created']) {
                    echo "Published configuration: config/{$result['name']}.php" . PHP_EOL;
                }
                if (!empty($result['migrations'])) {
                    echo "Package includes migration(s): " . implode(', ', $result['migrations']) . PHP_EOL;
                    echo "Run: php bongo migrate" . PHP_EOL;
                }
            } else {
                $results = $installer->installAll($force, $backup);
                if (empty($results)) {
                    echo "No packages enabled in config/packages.php." . PHP_EOL;
                    echo "Enable a package in config/packages.php or run: php bongo add <name>" . PHP_EOL;
                } else {
                    foreach ($results as $res) {
                        echo "Installed {$res['name']} ({$res['version']})." . PHP_EOL;
                    }
                }
            }
            break;

        case 'package:update':
            $target = $options[0] ?? null;
            $force = $hasOption('force');
            $backup = $hasOption('backup');
            $installer = new System\Package\Installer();
            $pkgName = ($target && !str_starts_with($target, '--')) ? $target : null;
            $results = $installer->update($pkgName, $force, $backup);
            if ($pkgName !== null) {
                $results = [$pkgName => $results];
            }
            foreach ($results as $pkg => $res) {
                if (($res['status'] ?? '') === 'up_to_date') {
                    echo "Package $pkg is already up to date ({$res['version']})." . PHP_EOL;
                } else {
                    echo "Updated $pkg {$res['old_version']} → {$res['version']}." . PHP_EOL;
                    if (!empty($res['backup'])) {
                        echo "  Backed up previous files to: " . relative_path($res['backup']) . PHP_EOL;
                    }
                }
            }
            break;

        case 'package:remove':
            $name = $options[0] ?? null;
            if (!$name || str_starts_with($name, '--')) {
                throw new RuntimeException("Usage: php bongo package:remove <package> [--force]");
            }
            $force = $hasOption('force');
            $installer = new System\Package\Installer();
            $res = $installer->remove($name, $force);
            echo "Removed package {$res['name']}." . PHP_EOL;
            if (!empty($res['migrations'])) {
                echo "\033[33mNote:\033[0m Package had migrations: " . implode(', ', $res['migrations']) . PHP_EOL;
                echo "If you ran these migrations, you may want to roll them back or clean up their tables." . PHP_EOL;
            }
            break;

        case 'package:list':
            $installer = new System\Package\Installer();
            $catalog = $installer->catalog();
            $installed = System\Package\PackageManager::installed();
            echo "Official Bongo Packages:\n\n";
            printf("  %-16s %-12s %-10s %s\n", "Package", "Installed", "Latest", "Description");
            printf("  %-16s %-12s %-10s %s\n", "-------", "---------", "------", "-----------");
            $all = array_unique(array_merge(array_keys($catalog), array_keys($installed)));
            sort($all);
            foreach ($all as $pkg) {
                $instVer = $installed[$pkg]['version'] ?? '-';
                $latest = $catalog[$pkg]['latest'] ?? '-';
                $desc = $catalog[$pkg]['description'] ?? ($installed[$pkg]['description'] ?? '');
                $status = '';
                if ($instVer !== '-' && $latest !== '-' && version_compare($instVer, $latest, '<')) {
                    $status = " (update available: $latest)";
                }
                printf("  %-16s %-12s %-10s %s%s\n", $pkg, $instVer, $latest, $desc, $status);
            }
            break;

        case 'package:publish':
            $name = $options[0] ?? null;
            if (!$name || str_starts_with($name, '--')) {
                throw new RuntimeException("Usage: php bongo package:publish <package> [--config] [--views] [--lang]");
            }
            $tags = [];
            if ($hasOption('config')) {
                $tags[] = 'config';
            }
            if ($hasOption('views')) {
                $tags[] = 'views';
            }
            if ($hasOption('lang')) {
                $tags[] = 'lang';
            }
            $installer = new System\Package\Installer();
            $published = $installer->publish($name, $tags);
            if (empty($published)) {
                echo "No files found to publish for package '$name'." . PHP_EOL;
            } else {
                echo "Published assets for '$name':" . PHP_EOL;
                foreach ($published as $item) {
                    echo "  $item" . PHP_EOL;
                }
            }
            break;

        case 'package:diff':
            $name = $options[0] ?? null;
            if (!$name || str_starts_with($name, '--')) {
                throw new RuntimeException("Usage: php bongo package:diff <package>");
            }
            $installer = new System\Package\Installer();
            $diff = $installer->diff($name);
            if (empty($diff['modified']) && empty($diff['added']) && empty($diff['deleted'])) {
                echo "No local modifications in packages/$name (clean)." . PHP_EOL;
            } else {
                echo "Local modifications in packages/$name:" . PHP_EOL;
                foreach ($diff['modified'] as $f) {
                    echo "  \033[33mmodified:\033[0m $f" . PHP_EOL;
                }
                foreach ($diff['added'] as $f) {
                    echo "  \033[32madded:\033[0m    $f" . PHP_EOL;
                }
                foreach ($diff['deleted'] as $f) {
                    echo "  \033[31mdeleted:\033[0m  $f" . PHP_EOL;
                }
            }
            break;

        case 'package:test':
            $name = $options[0] ?? null;
            if (!$name || str_starts_with($name, '--')) {
                throw new RuntimeException("Usage: php bongo package:test <package>");
            }
            $pkgDir = BASE_PATH . '/packages/' . $name;
            if (!is_dir($pkgDir)) {
                throw new RuntimeException("Package '$name' is not installed.");
            }
            $testsDir = $pkgDir . '/tests';
            if (!is_dir($testsDir)) {
                echo "No tests found in packages/$name/tests." . PHP_EOL;
                break;
            }
            exit(System\Testing\Runner::run($testsDir));

        case 'benchmark':
            $urls = array_values(array_filter($options, fn($o) => str_starts_with($o, '--url=')));
            $urls = $urls ? array_map(fn($o) => '/' . ltrim(substr($o, 6), '/'), $urls) : ['/', '/api/health'];
            exit(System\Console\Benchmark::run($urls, max(10, (int) $optionValue('requests', 200)), (string) $optionValue('opcache', 'both')));

        case 'test':
            exit(System\Testing\Runner::run(base_path('tests'), $options[0] ?? null));

        case 'help':
        default:
            $custom = loadCustomCommands();
            if ($command !== 'help' && isset($custom[$command])) {
                $status = $custom[$command]->handle($options, parseCommandOptions($options));
                exit((int) $status);
            }
            if ($command !== 'help') {
                echo "Unknown command: $command\n\n";
            }
            $help = [
                'about' => 'Version, PHP, environment, drivers and framework size',
                'benchmark [--url=/] [--requests=200] [--opcache=both|on|off]' => 'Measure request time and memory (OpCache off vs on)',
                'serve [--port=8000] [--host=127.0.0.1]' => 'Start the development server',
                'down [--message=] [--retry=60] [--secret=]' => 'Maintenance mode: visitors see "back soon" (503)',
                'up' => 'Leave maintenance mode',
                'upgrade [--check|--from=file|--rollback]' => 'Update the framework files only (backup first)',
                'migrate [--database=]' => 'Run pending database/migrations/*.php',
                'migrate:status [--database=]' => 'Show which migrations have run (and their batch)',
                'migrate:rollback [--step=1] [--database=]' => 'Undo the last batch(es) of migrations',
                'migrate:fresh [--force] [--seed] [--database=]' => 'Drop all tables, migrate (and seed)',
                'make:migration <name>' => 'Create a migration file, e.g. create_posts_table',
                'db:seed [--database=]' => 'Run database/seeders/DatabaseSeeder.php',
                'key:generate [--show] [--force]' => 'Create APP_KEY in .env (password pepper + encryption)',
                'route:list [filter]' => 'Show every route with its name, action and middleware',
                'tinker' => 'Interactive PHP shell with the app loaded',
                'make:controller <Name> [--api]' => 'Create a controller in app/Http/Controllers',
                'make:model <Name> [--migration]' => 'Create a model (and its migration)',
                'make:middleware <Name>' => 'Create a middleware class',
                'make:request <Name>' => 'Create a form request (rules + authorize) in app/Http/Requests',
                'make:policy <Name>' => 'Create a policy in app/Policies (who may update/delete)',
                'make:job <Name>' => 'Create a queued job in app/Jobs',
                'make:component <name>' => 'Create a view component: resources/views/components (<x-name>)',
                'make:seeder <Name>' => 'Create a seeder in database/seeders',
                'make:notification <Name>' => 'Create a notification (mail/sms/slack) in app/Notifications',
                'make:command <Name>' => 'Create a custom console command in app/Commands',
                'make:mail <name>' => 'Create an email template in resources/views/emails',
                'make:test <Name> [--unit]' => 'Create a feature (or unit) test',
                'security:check' => 'Deployment security checklist (exit 1 on failures)',
                'queue:work [--once] [--stop-when-empty]' => 'Run queued jobs (QUEUE_DRIVER=database or redis)',
                'queue:failed / queue:retry <id|all>' => 'List / retry failed jobs',
                'queue:flush' => 'Delete all failed jobs',
                'schedule:run' => 'Run due scheduled tasks (call it every minute)',
                'schedule:work' => 'Run the scheduler every minute in this terminal (no cron needed)',
                'schedule:list' => 'Show scheduled tasks and their next run',
                'websocket:serve [--port=6001] [--host=]' => 'Live updates: push Broadcast::to(...)->send() to open pages',
                'cache:clear' => 'Delete everything in the cache',
                'config:cache' => 'Cache config/ and .env in one file for faster requests (run on deploy)',
                'config:clear' => 'Remove the config cache',
                'route:cache' => 'Cache routes into one file for faster dispatching (run on deploy)',
                'route:clear' => 'Remove the route cache',
                'view:cache' => 'Precompile and lint every template (run on deploy)',
                'view:clear' => 'Delete compiled templates in storage/cache/views',
                'log:clear' => 'Delete the log files in storage/logs',
                'test [filter]' => 'Run the tests in tests/',
                'add <name>[@version]' => 'Add/uncomment a package in config/packages.php and install it',
                'package:install [<name>]' => 'Install packages from config/packages.php or install a package',
                'package:update [name]' => 'Update package(s) to latest allowed version',
                'package:remove <name> [--force]' => 'Remove package files and comment out in config/packages.php',
                'package:list' => 'List installed packages, versions and available updates',
                'package:publish <name>' => 'Publish package config, views, or translations into app',
                'package:diff <name>' => 'Show local modifications inside packages/<name>',
                'package:test <name>' => 'Run tests for an installed package',
                'help' => 'Show this help',
            ];
            $builtIn = array_map(fn($usage) => strtok($usage, ' '), array_keys($help));
            foreach (loadCustomCommands() as $customName => $customCmd) {
                if (in_array($customName, $builtIn, true)) {
                    fwrite(STDERR, "app/Commands: \"$customName\" has the name of a built-in command and never runs. Rename it." . PHP_EOL);
                    continue;
                }
                $help[$customName] = $customCmd->getDescription() ?: 'Custom application command';
            }
            if (is_file(BASE_PATH . '/release/tools/commands.php')) {
                require_once BASE_PATH . '/release/tools/commands.php';
                $help += RELEASE_COMMANDS_HELP;
            }
            echo 'Bongo ' . System\Framework::version() . " commands:\n";
            foreach ($help as $usage => $description) {
                printf("  %-44s %s\n", $usage, $description);
            }
            break;
    }
} catch (Throwable $e) {
    fwrite(STDERR, get_class($e) . ': ' . $e->getMessage() . "\n");
    exit(1);
}

function runSeeder(?string $database = null): void
{
    require_once base_path('database/seeders/DatabaseSeeder.php');
    $prev = System\Database\Connection::getDefaultConnection();
    if ($database !== null) {
        System\Database\Connection::setDefaultConnection($database);
    }
    try {
        (new Database\Seeders\DatabaseSeeder())->run();
        echo "Database seeded" . ($database ? " on connection [$database]" : "") . ".\n";
    } finally {
        if ($database !== null) {
            System\Database\Connection::setDefaultConnection($prev);
        }
    }
}

/** @return array<string, System\Console\Command> */
function loadCustomCommands(): array
{
    $commands = [];
    $dir = BASE_PATH . '/app/Commands';
    if (!is_dir($dir)) {
        return [];
    }
    foreach (glob($dir . '/*.php') ?: [] as $file) {
        // One broken command file must not break every other command
        try {
            require_once $file;
            $class = 'App\\Commands\\' . basename($file, '.php');
            if (class_exists($class) && is_subclass_of($class, System\Console\Command::class) && !(new ReflectionClass($class))->isAbstract()) {
                /** @var System\Console\Command $instance */
                $instance = new $class();
                if ($instance->getName() !== '') {
                    $commands[$instance->getName()] = $instance;
                }
            }
        } catch (Throwable $e) {
            fwrite(STDERR, "Skipped app/Commands/" . basename($file) . ': ' . get_class($e) . ': ' . $e->getMessage() . PHP_EOL);
        }
    }
    if (class_exists(System\Package\PackageManager::class)) {
        foreach (System\Package\PackageManager::commands() as $pkgCmd) {
            if ($pkgCmd->getName() !== '' && !isset($commands[$pkgCmd->getName()])) {
                $commands[$pkgCmd->getName()] = $pkgCmd;
            }
        }
    }
    return $commands;
}

function parseCommandOptions(array $rawOptions): array
{
    $options = [];
    foreach ($rawOptions as $opt) {
        if (str_starts_with($opt, '--')) {
            $parts = explode('=', substr($opt, 2), 2);
            $options[$parts[0]] = $parts[1] ?? true;
        }
    }
    return $options;
}

#!/usr/bin/env php
<?php
// BongoMVC command line tool: php bongo <command>

require __DIR__ . '/config/bootstrap.php';

use System\Database\Migrator;

$args = array_slice($_SERVER['argv'], 1);
$command = $args[0] ?? 'help';
$options = array_slice($args, 1);
$hasOption = fn(string $name) => in_array("--$name", $options, true);
$optionValue = function (string $name, $default = null) use ($options) {
    foreach ($options as $opt) {
        if (str_starts_with($opt, "--$name=")) return substr($opt, strlen($name) + 3);
    }
    return $default;
};

try {
    switch ($command) {
        case 'serve':
            $host = $optionValue('host', '127.0.0.1');
            $port = (int) $optionValue('port', env('APP_PORT', 8000));
            echo "Starting development server: http://$host:$port\n";
            echo "Press Ctrl+C to stop.\n";
            passthru(escapeshellarg(PHP_BINARY) . " -S $host:$port -t " . escapeshellarg(__DIR__ . '/public'));
            break;

        case 'migrate':
            $done = (new Migrator(base_path('database/migrations')))->migrate(fn($name) => print("Migrated: $name\n"));
            echo $done ? "Done.\n" : "Nothing to migrate.\n";
            break;

        case 'migrate:status':
            $rows = (new Migrator(base_path('database/migrations')))->status();
            if (!$rows) {
                echo "No migrations found.\n";
                break;
            }
            $width = max(array_map(fn($r) => strlen($r['migration']), $rows)) + 2;
            printf("%-{$width}s %-8s %-6s %s\n", 'Migration', 'Status', 'Batch', 'Ran at');
            foreach ($rows as $r) {
                $status = $r['ran'] ? ($r['missing'] ? 'Ran*' : 'Ran') : 'Pending';
                printf("%-{$width}s %-8s %-6s %s\n", $r['migration'], $status, $r['batch'] ?? '', $r['ran_at'] ?? '');
            }
            if (array_filter($rows, fn($r) => $r['missing'])) {
                echo "\n* recorded in the migrations table but the file is missing\n";
            }
            break;

        case 'migrate:rollback':
            $steps = (int) $optionValue('step', 1);
            $done = (new Migrator(base_path('database/migrations')))->rollback($steps, fn($name) => print("Rolled back: $name\n"));
            echo $done ? "Done.\n" : "Nothing to roll back.\n";
            break;

        case 'make:migration':
            if (empty($options[0])) {
                echo "Usage: php bongo make:migration create_posts_table\n";
                exit(1);
            }
            $file = (new Migrator(base_path('database/migrations')))->make($options[0]);
            echo 'Created: ' . relativePath($file) . PHP_EOL;
            break;

        case 'migrate:fresh':
            $database = config('database.connections.' . config('database.default') . '.database');
            if (!$hasOption('force')) {
                echo "This drops ALL tables in database [$database]. Type the database name to continue: ";
                if (trim((string) fgets(STDIN)) !== $database) {
                    echo "Cancelled.\n";
                    exit(1);
                }
            }
            $migrator = new Migrator(base_path('database/migrations'));
            foreach ($migrator->dropAllTables() as $table) echo "Dropped: $table\n";
            $migrator->migrate(fn($name) => print("Migrated: $name\n"));
            if ($hasOption('seed')) {
                runSeeder();
            }
            break;

        case 'db:seed':
            runSeeder();
            break;

        case 'key:generate':
            $key = System\Security\Key::generate();
            if ($hasOption('show')) {
                echo $key . "\n";
                break;
            }

            $envFile = base_path('.env');
            if (!file_exists($envFile)) {
                copy(base_path('.env.example'), $envFile);
            }
            $contents = file_get_contents($envFile);

            if (preg_match('/^APP_KEY=(.+)$/m', $contents, $m) && trim($m[1]) !== '' && !$hasOption('force')) {
                echo "APP_KEY is already set. Changing it invalidates every stored password and encrypted value.\n";
                echo "Use --force only if you really want a new key.\n";
                exit(1);
            }

            $contents = preg_match('/^APP_KEY=.*$/m', $contents)
                ? preg_replace('/^APP_KEY=.*$/m', 'APP_KEY=' . $key, $contents)
                : rtrim($contents) . "\nAPP_KEY=" . $key . "\n";
            file_put_contents($envFile, $contents);
            echo "Application key set in .env\n";
            break;

        case 'route:list':
            $router = System\Routing\Router::fromConfig();
            $rows = [];
            foreach ($router->routes() as $route) {
                $action = $route->action instanceof Closure ? 'Closure'
                    : (new ReflectionClass(class_exists($route->action[0]) ? $route->action[0] : 'App\\Http\\Controllers\\' . $route->action[0]))->getShortName() . '@' . $route->action[1];
                $middleware = array_map(fn($m) => (new ReflectionClass($m[0]))->getShortName() . ($m[1] ? ':' . implode(',', $m[1]) : ''), $router->resolveMiddleware($route));
                $rows[] = [implode('|', array_diff($route->methods, ['HEAD'])), $route->path, $route->name ?? '', $action, implode(', ', $middleware)];
            }
            $filter = $options[0] ?? null;
            if ($filter) {
                $rows = array_filter($rows, fn($r) => stripos(implode(' ', $r), $filter) !== false);
            }
            $widths = [6, 4, 4, 6, 10];
            foreach ($rows as $r) foreach ($r as $i => $v) $widths[$i] = max($widths[$i], strlen($v));
            $line = fn($r) => vsprintf("%-{$widths[0]}s  %-{$widths[1]}s  %-{$widths[2]}s  %-{$widths[3]}s  %s
", $r);
            echo $line(['Method', 'Path', 'Name', 'Action', 'Middleware']);
            foreach ($rows as $r) echo $line($r);
            echo "
" . count($rows) . " route(s)
";
            break;

        case 'tinker':
            echo "BongoMVC tinker. The app is loaded: try DB::table('users')->count(), config('app'), Hash::make('x').\n";
            echo "Type exit to quit.\n";
            foreach (['DB' => System\Database\DB::class, 'Schema' => System\Database\Schema\Schema::class, 'Log' => System\Log\Log::class,
                      'Hash' => System\Security\Hash::class, 'Crypt' => System\Security\Crypt::class, 'Auth' => System\Auth\Auth::class] as $alias => $class) {
                if (!class_exists($alias, false)) class_alias($class, $alias);
            }
            $dumper = new System\Debug\Dumper();
            while (true) {
                $line = function_exists('readline') ? readline('>>> ') : (fwrite(STDOUT, '>>> ') ? fgets(STDIN) : false);
                if ($line === false || in_array(trim($line), ['exit', 'quit'], true)) break;
                $code = trim($line);
                if ($code === '') continue;
                if (function_exists('readline_add_history')) readline_add_history($code);
                $code = rtrim($code, ';');
                try {
                    $result = eval(str_starts_with($code, 'return ') || preg_match('/^(echo|print|if|foreach|for|while|function|class)\b/', $code) ? "$code;" : "return $code;");
                    echo '=> ' . $dumper->text($result);
                } catch (Throwable $e) {
                    echo get_class($e) . ': ' . $e->getMessage() . "\n";
                }
            }
            break;

        case 'make:controller':
        case 'make:model':
        case 'make:middleware':
        case 'make:test':
            $name = $options[0] ?? '';
            if ($name === '' || str_starts_with($name, '--')) {
                $flags = ['make:controller' => ' [--api]', 'make:model' => ' [--migration]', 'make:test' => ' [--unit]'];
                echo "Usage: php bongo $command <Name>" . ($flags[$command] ?? '') . PHP_EOL;
                exit(1);
            }
            $generator = new System\Console\Generator(BASE_PATH);
            $created = match ($command) {
                'make:controller' => $generator->controller($name, $hasOption('api')),
                'make:model'      => $generator->model($name),
                'make:middleware' => $generator->middleware($name),
                'make:test'       => $generator->test($name, $hasOption('unit')),
            };
            echo "Created: $created" . PHP_EOL;
            if ($command === 'make:model' && $hasOption('migration')) {
                $table = $generator->tableName(basename(strtr($name, '\\', '/')));
                $file = (new Migrator(base_path('database/migrations')))->make("create_{$table}_table");
                echo 'Created: ' . relativePath($file) . PHP_EOL;
            }
            break;

        case 'security:check':
            $results = System\Security\SecurityCheck::run();
            $marks = ['ok' => "\033[32m  OK  \033[0m", 'warn' => "\033[33m WARN \033[0m", 'fail' => "\033[31m FAIL \033[0m"];
            $width = max(array_map(fn($r) => strlen($r['check']), $results)) + 2;
            echo 'Security check (APP_ENV=' . config('app.env') . ')' . PHP_EOL . PHP_EOL;
            foreach ($results as $r) {
                printf("%s %-{$width}s %s%s", $marks[$r['status']], $r['check'], $r['detail'], PHP_EOL);
            }
            $summary = System\Security\SecurityCheck::summary($results);
            echo PHP_EOL . ($summary === 'ok' ? 'All checks passed.' : ($summary === 'warn' ? 'Some warnings: review them before going live.' : 'Some checks FAILED: fix them before going live.')) . PHP_EOL;
            exit($summary === 'fail' ? 1 : 0);

        case 'cache:clear':
            echo 'Removed ' . System\Cache\Cache::flush() . ' cache file(s)' . PHP_EOL;
            break;

        case 'view:clear':
            $removed = System\View\ViewEngine::shared()->clearCache();
            echo "Removed $removed compiled view(s)
";
            break;

        case 'log:clear':
            $dir = config('logging.path');
            $removed = 0;
            foreach (glob($dir . '/*.log') ?: [] as $file) {
                $removed += (int) @unlink($file);
            }
            echo "Removed $removed log file(s) from " . str_replace(BASE_PATH . DIRECTORY_SEPARATOR, '', $dir) . "
";
            break;

        case 'test':
            exit(System\Testing\Runner::run(base_path('tests'), $options[0] ?? null));

        case 'help':
        default:
            echo "BongoMVC commands:\n";
            echo "  serve [--port=8000] [--host=127.0.0.1]  Start the development server\n";
            echo "  migrate                                  Run pending database/migrations/*.php\n";
            echo "  migrate:status                           Show which migrations have run (and their batch)\n";
            echo "  migrate:rollback [--step=1]              Undo the last batch(es) of migrations\n";
            echo "  make:migration <name>                    Create a migration file, e.g. create_posts_table\n";
            echo "  migrate:fresh [--force] [--seed]         Drop all tables, migrate (and seed)\n";
            echo "  db:seed                                  Run database/seeders/DatabaseSeeder.php\n";
            echo "  key:generate [--show] [--force]          Create APP_KEY in .env (password pepper + encryption)\n";
            echo "  route:list [filter]                      Show every route with its name, action and middleware
";
            echo "  tinker                                   Interactive PHP shell with the app loaded
";
            echo "  make:controller <Name> [--api]           Create a controller in app/Http/Controllers
";
            echo "  make:model <Name> [--migration]          Create a model (and its migration)
";
            echo "  make:middleware <Name>                   Create a middleware class
";
            echo "  make:test <Name> [--unit]                Create a feature (or unit) test
";
            echo "  security:check                           Deployment security checklist (exit 1 on failures)
";
            echo "  cache:clear                              Delete everything in the file cache
";
            echo "  view:clear                               Delete compiled templates in storage/cache/views
";
            echo "  log:clear                                Delete the log files in storage/logs
";
            echo "  test [filter]                            Run the tests in tests/\n";
            echo "  help                                     Show this help\n";
            break;
    }
} catch (Throwable $e) {
    fwrite(STDERR, get_class($e) . ': ' . $e->getMessage() . "\n");
    exit(1);
}

/** "D:\project/database\x.php" → "database/x.php" */
function relativePath(string $file): string
{
    $file = str_replace('\\', '/', $file);
    $base = str_replace('\\', '/', BASE_PATH) . '/';
    return str_starts_with($file, $base) ? substr($file, strlen($base)) : $file;
}

function runSeeder(): void
{
    require_once base_path('database/seeders/DatabaseSeeder.php');
    (new Database\Seeders\DatabaseSeeder())->run();
    echo "Database seeded.\n";
}
